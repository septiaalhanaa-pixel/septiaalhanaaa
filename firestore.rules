rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable validation helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Maritime Master Data: Vessels, Ports, Routes, Commodities
    match /vessels/{vesselId} {
      allow get, list: if true;
      allow write: if isValidId(vesselId);
    }

    match /ports/{portId} {
      allow get, list: if true;
      allow write: if isValidId(portId);
    }

    match /routes/{routeId} {
      allow get, list: if true;
      allow write: if isValidId(routeId);
    }

    match /commodities/{commodityId} {
      allow get, list: if true;
      allow write: if isValidId(commodityId);
    }

    // Shipper Customers
    match /customers/{customerId} {
      allow get, list: if true;
      allow write: if isValidId(customerId);
    }

    // Bookings & Bill of Lading (B/L)
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow write: if isValidId(bookingId);
    }

    // Voyage Logs & GPS Tracking
    match /voyages/{voyageId} {
      allow get, list: if true;
      allow write: if isValidId(voyageId);
    }

    // Automated Notifications & WhatsApp Logs
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow write: if isValidId(notificationId);
    }

    // Maritime App Users & Profiles
    match /users/{userId} {
      allow get, list: if true;
      allow write: if isValidId(userId);
    }

    // Healthcheck / Connection Probe
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
